+    fn build_global_filename_kesh_pattern() {
+        let date = NaiveDate::from_ymd_opt(2026, 5, 17).unwrap();
+        assert_eq!(
+            build_global_filename("CI Test Company", date),
+            "kesh-export-ci-test-company-2026-05-17.zip"
